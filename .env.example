# 복사해서 .env로 저장하고 값을 채운다. .env는 git에 올라가지 않는다.
# 실행: uv run --env-file .env policy-signal-map

# 공개 배포용 합성 근거 파일. 이 저장소에는 비공개 실데이터를 두지 않는다.
PSM_EVIDENCE_PATH=src/policy_signal_map/resources/evidence/review_evidence_hierarchy_v1.json
PSM_REGION_MAPPING_PATH=

# 세션: 로컬은 memory, Vercel은 redis를 쓴다.
PSM_SESSION_BACKEND=memory
# 마지막 이용 후 세션 유지 시간(초). 기본 24시간
PSM_SESSION_TTL_S=86400
# Vercel에서 Upstash Redis를 연결하면 자동으로 들어오는 값. 실제 값은 Secret에만 둔다.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# AI 참고 의견: none 또는 google_ai
PSM_LLM_PROVIDER=google_ai
# Google AI Studio에서 발급한 키. 실제 값은 .env나 배포 서비스의 Secret에만 넣는다.
GEMINI_API_KEY=
# 화면 순서: Gemini 3.8 → 3.6 → 2.5 Pro → Gemma 4 31B
PSM_LLM_MODELS=gemini-3.8-flash,gemini-3.6-flash,gemini-2.5-pro,gemma-4-31b-it
PSM_LLM_MODEL=gemini-3.8-flash
# AI 응답을 기다릴 최대 시간(초). 비우면 45
PSM_LLM_TIMEOUT_S=45
