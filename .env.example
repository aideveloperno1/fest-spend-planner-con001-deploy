# 복사해서 .env로 저장하고 값을 채운다. .env는 git에 올라가지 않는다.
# 실행: uv run --env-file .env policy-signal-map

# 공개 배포용 합성 근거 파일. 이 저장소에는 비공개 실데이터를 두지 않는다.
PSM_EVIDENCE_PATH=src/policy_signal_map/resources/evidence/review_evidence_public_v2.1.json
# 공개 전달본은 가상 지역 키를 사용하므로 실제 지역 대응표가 필요 없다.
PSM_REGION_MAPPING_PATH=

# AI 참고 의견. 값: none, local (cloud는 설정만 있고 아직 구현하지 않음)
# none이면 3단계 화면에 AI 영역이 나오지 않는다.
PSM_LLM_PROVIDER=local
# local일 때: OpenAI 호환 서버 주소 (Ollama 기본값 예시)
PSM_LLM_BASE_URL=http://127.0.0.1:11434/v1
# local일 때: 담당자가 3단계에서 고를 수 있는 모델 (쉼표로 구분, 적은 순서대로 표시)
# 모델이 하나면 선택 칸이 나오지 않는다. 받아 둔 모델 이름은 `ollama list`로 확인
PSM_LLM_MODELS=exaone3.5:7.8b
# 기본 모델 (비우면 위 목록의 첫 모델). cloud일 때는 필수
PSM_LLM_MODEL=exaone3.5:7.8b
# cloud일 때: API 키
PSM_LLM_API_KEY=
# AI 응답을 기다릴 최대 시간(초). 비우면 120 (기본값은 config.py의 DEFAULT_LLM_TIMEOUT_S)
# 모델을 바꾼 뒤 첫 응답은 모델을 메모리에 올리느라 오래 걸린다 (측정: 4.8GB 모델도 약 40초)
# 느린 PC에서 "불러오지 못했습니다"가 자주 보이면 이 값을 늘린다. 예: PSM_LLM_TIMEOUT_S=90
PSM_LLM_TIMEOUT_S=
